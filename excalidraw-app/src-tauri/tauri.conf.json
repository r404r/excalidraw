{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "excalidraw-app",
  "version": "1.0.5",
  "identifier": "com.app.excalidraw",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cross-env VITE_APP_TAURI=true npm run start",
    "beforeBuildCommand": "cross-env VITE_APP_TAURI=true yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "excalidraw-app",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Excalidraw App",
    "longDescription": "Excalidraw Desktop Application using Tauri by r404r"
  }
}
